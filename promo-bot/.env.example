# Token del bot, creado con @BotFather.
# Consejo: creá DOS bots — uno de PRODUCCIÓN (va en Railway) y uno de PRUEBA (va en tu .env local).
# El mismo token no puede correr en dos lados a la vez (Telegram tira error 409 Conflict).
BOT_TOKEN=

# Connection string de Postgres (Supabase → Settings → Database → Connection string / URI).
# Incluye la contraseña de la base. Va acá y en Variables de Railway; NUNCA se commitea.
DATABASE_URL=

# Chat ID de admin, para avisos internos (opcional)
ADMIN_CHAT_ID=

# telegram_id del DUEÑO del bot: único destinatario de /ajuste y /promoprecios (área Calidad),
# y único que puede usar /carteleria_prueba (área Depósito, modo prueba de /carteleria).
# No es lo mismo que "admin" (puede haber varios admins reales; esto es exclusivamente esta persona).
OWNER_TELEGRAM_ID=

# telegram_id de la persona de Marketing con su propia copia personal de /carteleria
# (/carteleria_marketing, ver scenes/carteleria.js) — todo el circuito le vuelve a ella.
MARKETING_CARTELERIA_TELEGRAM_ID=

# Número de WhatsApp de "la gráfica" (proveedor externo de cartelería), solo dígitos con código de
# país, para el link wa.me de /carteleria (área Depósito).
GRAFICA_WHATSAPP_NUMBER=

# URL del proyecto de Supabase (Settings → API → Project URL), para traer las fotos del
# catálogo de productos desde Storage (bucket público "productos" — no hace falta ninguna key,
# ver assets/productos/README.md).
SUPABASE_STORAGE_URL=

# --- Talo (bajada automática del extracto, src/lib/talo-api.js) ---
# Se generan en el panel de Talo: Dashboard > Usuario > Credenciales.
# Sin esto hay que seguir bajando a mano el "Movimientos_<desde>_<hasta>.xlsx".
TALO_USER_ID=
TALO_CLIENT_ID=
TALO_CLIENT_SECRET=
# Opcional: https://sandbox-api.talo.com.ar para probar sin plata real (default: producción).
TALO_BASE_URL=
# Opcional: solo si tu cuenta usa equipos (team_id).
TALO_TEAM_ID=
